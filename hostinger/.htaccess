RewriteEngine On

RewriteRule ^verify/([A-Za-z0-9_-]+)/?$ verify.php?token=$1 [L,QSA]
RewriteRule ^windows/([A-Za-z0-9_-]+)/?$ api/os.php?os=windows&token=$1 [L,QSA]
RewriteRule ^mac/([A-Za-z0-9_-]+)/?$ api/os.php?os=mac&token=$1 [L,QSA]
RewriteRule ^linux/([A-Za-z0-9_-]+)/?$ api/os.php?os=linux&token=$1 [L,QSA]
RewriteRule ^windows/?$ api/os.php?os=windows [L]
RewriteRule ^mac/?$ api/os.php?os=mac [L]
RewriteRule ^linux/?$ api/os.php?os=linux [L]
RewriteRule ^issue/?$ issue.php [L]

<IfModule mod_authz_core.c>
	<Files "tokens.json">
		Require all denied
	</Files>
</IfModule>
