# Google Maps JavaScript API (optional). Without these, the demo uses the schematic map.
# Browser keys are visible to users — restrict by HTTP referrer and enable only Maps JavaScript API.
# See: https://developers.google.com/maps/documentation/javascript/get-api-key
PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID required for AdvancedMarkerElement. Use a Cloud Console map ID, or DEMO_MAP_ID for development.
# See: https://developers.google.com/maps/documentation/javascript/advanced-markers/overview
PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Secret for creating a 2-hour simulation link: /api/mint?secret=THIS_VALUE
# Leave empty to disable token creation.
MINT_SECRET=
